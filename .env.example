# MetaApi credentials — from https://app.metaapi.cloud
METAAPI_TOKEN=your_metaapi_token
METAAPI_ACCOUNT_ID=your_metaapi_account_id

# Any long random string — the Android app sends this back as a Bearer token.
API_KEY=change_this_to_something_long_and_random

# Comma-separated symbols to scan (must match your broker's exact symbol names)
SYMBOLS=XAUUSD,EURUSD,GBPUSD

# Timeframes MetaApi expects, e.g. 1m, 5m, 15m, 1h, 4h, 1d
HTF=1h
LTF=1m

# Risk per trade, as a percent of current equity
RISK_PERCENT=1.0

# How often the engine scans markets and refreshes account data (seconds)
POLL_INTERVAL_SECONDS=60

# Default daily limits (can be changed later from the app)
DAILY_SL_LIMIT=100
DAILY_TP_LIMIT=200

# Minimum sweep distance in points before a Turtle Soup wick counts as a real raid
MIN_SWEEP_POINTS=5
MAX_SWEEP_POINTS=40
